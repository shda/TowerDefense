  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Canvas Renderer \u0432 Unity \u2014 \u044D\u0442\u043E \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
    \u0437\u0430 \u043E\u0442\u0440\u0438\u0441\u043E\u0432\u043A\u0443 UI-\u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432,
    \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445 \u0441 Canvas (\u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u043C \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430
    \u0432 Unity).\r\n\r\n\U0001F539 \u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
    \u0444\u0443\u043D\u043A\u0446\u0438\u044F:\r\n\u041E\u0442\u0440\u0438\u0441\u043E\u0432\u044B\u0432\u0430\u0435\u0442
    \u0433\u0440\u0430\u0444\u0438\u043A\u0443 UI (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    Image, Text, RawImage \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0434\u043E\u0447\u0435\u0440\u043D\u0438\u043C\u0438 \u0434\u043B\u044F Canvas).\r\n\r\n\u041D\u0435
    \u0438\u043C\u0435\u0435\u0442 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043A
    \u0432 \u0438\u043D\u0441\u043F\u0435\u043A\u0442\u043E\u0440\u0435, \u0442\u0430\u043A
    \u043A\u0430\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u0432 \u0441\u0432\u044F\u0437\u043A\u0435 \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438
    UI-\u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430\u043C\u0438.\r\n\r\n\U0001F539
    \u041A\u0430\u043A \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F?\r\n\u041A\u043E\u0433\u0434\u0430
    \u0432\u044B \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442\u0435 UI-\u044D\u043B\u0435\u043C\u0435\u043D\u0442
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, Image \u0438\u043B"
  m_isRightToLeft: 0
